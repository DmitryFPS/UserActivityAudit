{
  "version": 1,
  "profile": "auto",
  "host_id": "",
  "server": {
    "ingest_url": "https://audit.example.com:8443",
    "mtls_cert_thumbprint": "",
    "upload_interval_minutes": 120
  },
  "collectors": {
    "session": true,
    "process": true,
    "foreground": true,
    "usb": true,
    "file": true,
    "network": true,
    "clipboard": false,
    "print": true,
    "l3_schedule_cron": "0 2 * * 0"
  },
  "paths": {
    "critical": [
      "%USERPROFILE%\\Documents",
      "%USERPROFILE%\\Desktop",
      "%USERPROFILE%\\Downloads"
    ],
    "sensitive": []
  },
  "alerts": {
    "usb_copy_threshold_mb": 10,
    "denylist_processes": [
      "tor.exe",
      "mimikatz.exe"
    ]
  },
  "storage": {
    "max_log_mb_per_day": 10,
    "retention_days": 90
  }
}
