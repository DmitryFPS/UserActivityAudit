{
  "version": 1,
  "profile": "auto",
  "host_id": "",
  "server": {
    "ingest_url": "",
    "mtls_cert_thumbprint": "",
    "upload_interval_minutes": 0
  },
  "collectors": {
    "session": true,
    "process": true,
    "foreground": true,
    "usb": true,
    "file": true,
    "network": true,
    "clipboard": false,
    "print": true,
    "forensic": true
  },
  "forensic": {
    "enabled": true,
    "trigger_on_usb": true,
    "schedule": "off",
    "max_browser_rows": 500,
    "max_prefetch_files": 50,
    "browser_chrome": true,
    "browser_edge": true,
    "browser_firefox": true,
    "artifact_prefetch": true,
    "artifact_userassist": true,
    "artifact_usb_registry": true
  },
  "paths": {
    "critical": [
      "%USERPROFILE%\\Documents",
      "%USERPROFILE%\\Desktop",
      "%USERPROFILE%\\Downloads"
    ],
    "sensitive": []
  },
  "storage": {
    "max_log_mb_per_day": 10,
    "retention_days": 90
  }
}
