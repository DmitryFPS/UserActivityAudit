@page
@model UserAudit.Portal.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<h1>UserActivityAudit Portal</h1>
<p class="text-muted">Commercial pilot — hosts, timeline, alerts</p>

<div class="row g-3">
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Hosts</h5>
                <p class="display-6">@Model.HostCount</p>
                <a class="btn btn-sm btn-primary" href="/Hosts">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Open alerts</h5>
                <p class="display-6">@Model.OpenAlertCount</p>
                <a class="btn btn-sm btn-danger" href="/Alerts">View</a>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card">
            <div class="card-body">
                <h5 class="card-title">Log blobs</h5>
                <p class="display-6">@Model.LogBlobCount</p>
                <a class="btn btn-sm btn-secondary" href="/Timeline">Timeline</a>
            </div>
        </div>
    </div>
</div>
