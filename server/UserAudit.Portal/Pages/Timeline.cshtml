@page
@model UserAudit.Portal.Pages.TimelineModel
@{
    ViewData["Title"] = "Timeline";
}

<h1>Event timeline</h1>
<table class="table table-sm">
    <thead>
    <tr>
        <th>Time (UTC)</th>
        <th>Host</th>
        <th>Category</th>
        <th>Action</th>
        <th>Severity</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model.Events)
    {
        <tr class="@(item.Category == "tamper" ? "table-danger" : "")">
            <td>@item.TimestampUtc.ToString("u")</td>
            <td>@item.Hostname</td>
            <td>@item.Category</td>
            <td>@item.Action</td>
            <td>@item.Severity</td>
        </tr>
    }
    </tbody>
</table>
