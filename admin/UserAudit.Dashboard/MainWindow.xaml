<Window x:Class="UserAudit.Dashboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="UserAudit — Анализ логов"
        Height="720" Width="1100"
        MinHeight="600" MinWidth="900">
    <DockPanel Margin="8">
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="Файл">
                <MenuItem Header="Обновить логи с диска" Click="RefreshLogs_Click"/>
                <MenuItem Header="Экспорт forensic pack (ZIP)..." Click="ExportForensicPack_Click"/>
                <Separator/>
                <MenuItem Header="Выход" Click="Exit_Click"/>
            </MenuItem>
        </Menu>

        <Expander DockPanel.Dock="Top" Header="Пути и ключ" IsExpanded="False" Margin="0,0,0,8">
            <Grid Margin="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="160"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Каталог логов" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="0" Grid.Column="1" Margin="4">
                    <Button Content="..." DockPanel.Dock="Right" Width="32" Click="BrowseLogFolder_Click"/>
                    <TextBox x:Name="LogFolderBox"/>
                </DockPanel>
                <TextBlock Grid.Row="1" Grid.Column="0" Text="Ключ DPAPI" VerticalAlignment="Center"/>
                <TextBox x:Name="KeysFolderBox" Grid.Row="1" Grid.Column="1" Margin="4" IsReadOnly="True"/>
                <TextBlock Grid.Row="2" Grid.Column="0" Text="DEK файл (опц.)" VerticalAlignment="Center"/>
                <DockPanel Grid.Row="2" Grid.Column="1" Margin="4">
                    <Button Content="..." DockPanel.Dock="Right" Width="32" Click="BrowseDek_Click"/>
                    <TextBox x:Name="DekPathBox"/>
                </DockPanel>
            </Grid>
        </Expander>

        <StatusBar DockPanel.Dock="Bottom">
            <StatusBarItem>
                <TextBlock x:Name="StatusText" Text="Готово"/>
            </StatusBarItem>
        </StatusBar>

        <TabControl>
            <TabItem Header="Обзор">
                <StackPanel Margin="12">
                    <TextBlock x:Name="ComputerNameText" FontWeight="SemiBold" Margin="0,0,0,12"/>
                    <WrapPanel>
                        <Border Margin="0,0,12,12" Padding="16" BorderBrush="#CCC" BorderThickness="1" MinWidth="180">
                            <StackPanel>
                                <TextBlock Text="Событий в журнале" FontWeight="SemiBold"/>
                                <TextBlock x:Name="EventCountText" FontSize="28"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,12" Padding="16" BorderBrush="#CCC" BorderThickness="1" MinWidth="180">
                            <StackPanel>
                                <TextBlock Text="Tamper / critical" FontWeight="SemiBold"/>
                                <TextBlock x:Name="AlertCountText" FontSize="28"/>
                            </StackPanel>
                        </Border>
                        <Border Margin="0,0,12,12" Padding="16" BorderBrush="#CCC" BorderThickness="1" MinWidth="220">
                            <StackPanel>
                                <TextBlock Text="Последний импорт" FontWeight="SemiBold"/>
                                <TextBlock x:Name="LastImportText" FontSize="14" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                    <Button Content="Обновить логи" Width="160" HorizontalAlignment="Left" Click="RefreshLogs_Click"/>
                </StackPanel>
            </TabItem>

            <TabItem Header="Хронология">
                <DataGrid x:Name="TimelineGrid" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время (UTC)" Binding="{Binding TimestampUtc}" Width="160"/>
                        <DataGridTextColumn Header="Категория" Binding="{Binding Category}" Width="100"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="140"/>
                        <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="90"/>
                        <DataGridTextColumn Header="Источник" Binding="{Binding SourceFile}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Тревоги">
                <DataGrid x:Name="AlertsGrid" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding CreatedAtUtc}" Width="160"/>
                        <DataGridTextColumn Header="Правило" Binding="{Binding RuleId}" Width="160"/>
                        <DataGridTextColumn Header="Описание" Binding="{Binding Title}" Width="*"/>
                        <DataGridTextColumn Header="Важность" Binding="{Binding Severity}" Width="90"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="USB">
                <DataGrid x:Name="UsbGrid" IsReadOnly="True" AutoGenerateColumns="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding TimestampUtc}" Width="160"/>
                        <DataGridTextColumn Header="Действие" Binding="{Binding Action}" Width="100"/>
                        <DataGridTextColumn Header="Correlation" Binding="{Binding CorrelationId}" Width="140"/>
                        <DataGridTextColumn Header="VID:PID" Binding="{Binding VidPid}" Width="100"/>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>

            <TabItem Header="Отчёты">
                <StackPanel Margin="12">
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="Дата отчёта:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <DatePicker x:Name="ReportDatePicker"/>
                    </StackPanel>
                    <TextBlock Text="Активность за день" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                        <Button Content="Excel" Width="90" Margin="0,0,8,0" Click="DailyExcel_Click"/>
                        <Button Content="PDF" Width="90" Click="DailyPdf_Click"/>
                    </StackPanel>
                    <TextBlock Text="USB-отчёт" FontWeight="SemiBold" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Content="Excel" Width="90" Margin="0,0,8,0" Click="UsbExcel_Click"/>
                        <Button Content="PDF" Width="90" Click="UsbPdf_Click"/>
                    </StackPanel>
                </StackPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
